<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- ADDED: -fx-border-color: #3f444c; -fx-border-width: 2; to match Production/Event -->

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #1a1c1e; -fx-background-radius: 12; -fx-border-color: #3f444c; -fx-border-width: 2; -fx-border-radius: 12;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.uge.but.schtroumpf.controller.gui.phases.ConsumptionPhaseController">
   
   <top>
      <VBox alignment="CENTER" spacing="6.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="BILAN DE CONSOMMATION" textAlignment="CENTER" textFill="#f8fafc">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label text="Fin du mois : Ravitaillement de la population" textFill="#91a6c4" />
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="15.0" />
         </padding>
      </VBox>
   </top>

   <center>
      <HBox alignment="CENTER" prefHeight="310.0" prefWidth="660.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="10.0" right="10.0" top="5.0" />
         </padding>
         <children>
            
                  <VBox spacing="15.0" style="-fx-background-color: #202225; -fx-border-color: #3f444c; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Population :" textFill="#91a6c4">
                           <font>
                              <Font size="14.0" />
                           </font></Label>
                        <Label fx:id="populationLabel" text="0 Schtroumpfs" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox fx:id="seasonContainer" alignment="CENTER" prefHeight="45.0">
                           <children>
                              <Label fx:id="seasonLabel" text="Label">
                                 <font>
                                    <Font name="System Bold" size="18.0" />
                                 </font>
                              </Label>
                           </children>
                           <padding>
                              <Insets left="8.0" right="8.0" />
                           </padding>
                        </HBox>
                     </children>
                  </HBox>
                  <ScrollPane fx:id="reportScrollpane" fitToWidth="true" hbarPolicy="NEVER" prefHeight="310.0" prefWidth="0.0" style="-fx-background-color: transparent; -fx-background: #202225; -fx-background-radius: 8; -fx-border-color: #3f444c; -fx-border-radius: 8; -fx-border-width: 1;">
                     <content>
                        
                              <VBox fx:id="reportContainer" spacing="8.0" />
                     </content>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <padding>
                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                     </padding>
                  </ScrollPane>
               </children>
               <HBox.margin>
                  <Insets left="20.0" right="20.0" />
               </HBox.margin>
            </VBox>
            
         </children>
      </HBox>
   </center>

   <!-- UPDATED: Button is now 45px high, bold 16, Emerald Green, centered exactly like EventView -->
   <bottom>
      <HBox alignment="CENTER" prefHeight="75.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="nextPhaseButton" mnemonicParsing="false" onAction="#handleNextPhaseButton" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Continuer le Tour">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Button>
         </children>
         <padding>
            <Insets bottom="20.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
