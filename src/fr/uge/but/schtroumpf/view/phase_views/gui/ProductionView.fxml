<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #1a1c1e; -fx-background-radius: 12; -fx-border-color: #3f444c; -fx-border-width: 2; -fx-border-radius: 12;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.uge.but.schtroumpf.controller.gui.phases.ProductionPhaseController">
   
   <!-- Header Area: Title -->
   <top>
      <VBox alignment="CENTER" spacing="5.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Bilan de collecte" textFill="#f8fafc">
               <font>
                  <Font name="System Bold" size="32.0" />
               </font>
            </Label>
            <!-- Decorative line underneath the title -->
            <HBox alignment="CENTER" />
         </children>
         <padding>
            <Insets bottom="10.0" top="30.0" />
         </padding>
      </VBox>
   </top>

   <!-- Center Area: Clean Dynamic Container Wrapper -->
   <center>
      <VBox alignment="CENTER" fillWidth="false" BorderPane.alignment="CENTER">
         <children>
            <!-- Scrollable or fixed vertical container for resource summary cards -->
            <VBox fx:id="resourcesContainer" alignment="TOP_CENTER" prefHeight="300.0" prefWidth="480.0" spacing="8.0" style="-fx-background-color: #202225; -fx-border-color: #3f444c; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;">
               <padding>
                  <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
               </padding>
               <children>
                  
                              <!-- EXAMPLE/DEFAULT RESOURCE ROW: Baies (Berries) -->
                  <HBox alignment="CENTER_LEFT" prefHeight="30.0" spacing="6.0">
                     <padding>
                        <Insets left="15.0" right="15.0" />
                     </padding>
                     <children>
                        <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true" />
                        
                                    <!-- 2. Value Delta Label (styled green for positive yield) -->
                        <Label alignment="CENTER" graphicTextGap="0.0" prefWidth="35.0" text="+15" textFill="#10b981">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        
                                    <!-- 3. Resource Name Label -->
                        <Label text="Baies" textFill="#f1f5f9">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  
                           </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
      </VBox>
   </center>

   <!-- Bottom Area: Validation Button aligned to the right -->
   <bottom>
      <HBox alignment="CENTER" prefHeight="70.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="nextPhaseButton" mnemonicParsing="false" onAction="#handleNextPhaseButton" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Continuer">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Button>
         </children>
         <padding>
            <Insets bottom="25.0" right="20.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
