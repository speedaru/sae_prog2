<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #1a1c1e; -fx-background-radius: 12; -fx-border-color: #3f444c; -fx-border-width: 2; -fx-border-radius: 12;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.uge.but.schtroumpf.controller.gui.phases.ConsumptionPhase">
   
   <!-- Header Area: Title -->
   <top>
      <VBox alignment="CENTER" spacing="5.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Bilan de collecte" textFill="#f8fafc">
               <font>
                  <Font name="System Bold" size="32.0" />
               </font>
            </Label>
            <!-- Decorative line underneath the title -->
            <HBox alignment="CENTER">
               <children>
                  <VBox prefHeight="3.0" prefWidth="120.0" style="-fx-background-color: #3b82f6; -fx-background-radius: 2;" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" top="30.0" />
         </padding>
      </VBox>
   </top>

   <!-- Center Area: Clean Dynamic Container Wrapper -->
   <center>
      <VBox alignment="CENTER" fillWidth="false" BorderPane.alignment="CENTER">
         <children>
            <!-- This is the container box styled matching the drawing's inner frame. 
                 It's ready to receive your custom resource widgets dynamically! -->
            <VBox fx:id="resourcesContainer" alignment="CENTER" prefHeight="220.0" prefWidth="480.0" spacing="12.0" style="-fx-background-color: #202225; -fx-border-color: #3f444c; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;">
               <padding>
                  <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
               </padding>
               <children>
                  <!-- Visual placeholder label (automatically removed or ignored when you add your elements) -->
                  <Label fx:id="placeholderLabel" text="[ Aucun objet collecté ]" textFill="#64748b">
                     <font>
                        <Font name="System Italic" size="14.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
      </VBox>
   </center>

   <!-- Bottom Area: Validation Button aligned to the right -->
   <bottom>
      <HBox alignment="CENTER_RIGHT" prefHeight="70.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="validerButton" mnemonicParsing="false" onAction="#handleValider" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Valider">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Button>
         </children>
         <padding>
            <Insets bottom="25.0" right="40.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>