<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="1024.0" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #1a1c1e;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.uge.but.schtroumpf.controller.gui.windows.GameController">
   
   <!-- TOP BAR: Month, Phase, Event Name, and Options Buttons -->
   <top>
      <HBox alignment="CENTER" prefHeight="80.0" prefWidth="1280.0" style="-fx-background-color: #25282c; -fx-border-color: #3f444c; -fx-border-width: 0 0 2 0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <!-- Month & Phase Indicators -->
            <VBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="220.0" spacing="4.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label text="Mois :" textFill="#b9bec6">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="monthLabel" text="Avril (04)" textFill="#f59e0b">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label text="Phase :" textFill="#b9bec6">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="phaseLabel" text="Conseil" textFill="#10b981">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <!-- Event Title / Status Banner (Centered) -->
            <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" style="-fx-background-color: #2d3139; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-border-width: 1;">
                     <children>
                        <Label fx:id="eventLabel" text="Événement: Gargamel" textAlignment="CENTER" textFill="#f8fafc">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets bottom="8.0" left="24.0" right="24.0" top="8.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
            
            <!-- Actions/Settings Panel (Top Right) -->
            <HBox alignment="CENTER_RIGHT" prefHeight="60.0" prefWidth="320.0" spacing="10.0">
               <children>
                  <Button fx:id="mysteriousButton" mnemonicParsing="false" onAction="#handleMysteriousButton" prefHeight="45.0" prefWidth="45.0" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="?">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Button>
                  <Button fx:id="encyclopediaButton" mnemonicParsing="false" onAction="#handleOpenEncyclopedia" prefHeight="45.0" prefWidth="90.0" style="-fx-background-color: #4b5563; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Encyclopédie" textAlignment="CENTER" wrapText="true">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Button>
                  <Button fx:id="uiToggleButton" mnemonicParsing="false" onAction="#handleToggleUI" prefHeight="45.0" prefWidth="90.0" style="-fx-background-color: #4b5563; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Vue sans UI" textAlignment="CENTER" wrapText="true">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Button>
                  <Button fx:id="settingsButton" mnemonicParsing="false" onAction="#handleOpenSettings" prefHeight="45.0" prefWidth="90.0" style="-fx-background-color: #4b5563; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Paramètres" textAlignment="CENTER" wrapText="true">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Button>
                  <Button fx:id="quitButton1" mnemonicParsing="false" onAction="#handleQuitButton1" prefHeight="45.0" prefWidth="90.0" style="-fx-background-color: darkred; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Quitter" textAlignment="CENTER" wrapText="true">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </HBox>
   </top>

   <!-- LEFT SIDEBAR: Pretty Resources Panel -->
   <left>
      <VBox prefWidth="240.0" spacing="15.0" style="-fx-background-color: #202225; -fx-border-color: #3f444c; -fx-border-width: 0 2 0 0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Ressources" textFill="#f1f5f9">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <FlowPane fx:id="resourcesContainer" hgap="10.0" prefHeight="85.0" prefWidth="208.0" vgap="10.0" />
         </children>
      </VBox>
   </left>

   <!-- CENTER PANEL: Subwindow Container -->
   <center>
      <StackPane fx:id="centerContainer" prefHeight="600.0" prefWidth="760.0" style="-fx-background-color: #161819;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <!-- Subwindows (like the Conseil table grid view) will be dynamically loaded inside this clean, empty placeholder -->
            <VBox alignment="CENTER" spacing="10.0" style="-fx-border-color: #3f444c; -fx-border-width: 2; -fx-border-style: dashed; -fx-background-color: #1d2022; -fx-background-radius: 10; -fx-border-radius: 10;">
               <children>
                  <Label text="[ Zone d'affichage des sous-fenêtres ]" textFill="#4b5563">
                     <font>
                        <Font name="System Italic" size="16.0" />
                     </font>
                  </Label>
                  <Label text="(Le contrôleur injectera dynamiquement vos menus ici)" textFill="#4b5563">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </StackPane>
   </center>

   <!-- RIGHT SIDEBAR: Pretty & Big Crisis Panel -->
   <right>
      <VBox prefWidth="260.0" spacing="15.0" style="-fx-background-color: #202225; -fx-border-color: #3f444c; -fx-border-width: 0 0 0 2;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <!-- Crisis Header Badge -->
            <HBox alignment="CENTER" minHeight="40.0" style="-fx-background-color: #991b1b; -fx-background-radius: 6; -fx-border-color: #ef4444; -fx-border-radius: 6;">
               <children>
                  <Label fx:id="crisisTitleLabel" text="CRISE : BAIES" textAlignment="CENTER" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            
            <!-- Cause Section -->
            <VBox prefHeight="130.0" spacing="8.0" style="-fx-background-color: #2d3139; -fx-padding: 12; -fx-background-radius: 8;">
               <children>
                  <Label text="Cause de la crise :" textFill="#fca5a5">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <Label fx:id="crisisCauseLabel" text="- Manque de baies criant dans les réserves du village." textFill="#e2e8f0" wrapText="true">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            
            <!-- Effects Section -->
            <VBox prefHeight="130.0" spacing="8.0" style="-fx-background-color: #2d3139; -fx-padding: 12; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="Effets actifs :" textFill="#fca5a5">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <Label fx:id="crisisEffectsLabel" text="- Malus de moral généralisé (-10%)\n- Risque de famine accru à la fin du cycle." textFill="#e2e8f0" wrapText="true">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            
            <!-- Crisis Pagination Controls -->
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="prevCrisisBtn" minWidth="45.0" mnemonicParsing="false" onAction="#handlePrevCrisis" style="-fx-background-color: #4b5563; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="&lt;">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <HBox alignment="CENTER" prefHeight="30.0" prefWidth="60.0" style="-fx-background-color: #2d3139; -fx-background-radius: 6; -fx-border-color: #4b5563; -fx-border-radius: 6;">
                     <children>
                        <Label fx:id="crisisPageLabel" text="1 / 3" textFill="#f1f5f9">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <Button fx:id="nextCrisisBtn" minWidth="45.0" mnemonicParsing="false" onAction="#handleNextCrisis" style="-fx-background-color: #4b5563; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="&gt;">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </right>
</BorderPane>
