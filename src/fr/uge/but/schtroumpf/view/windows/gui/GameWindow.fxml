<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="1024.0" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.uge.but.schtroumpf.controller.gui.windows.GameController">

   <ImageView fitHeight="720.0" fitWidth="1280.0" preserveRatio="false">
      <image>
         <Image url="/sprites/les-schtroumpfs.png" />
      </image>
   </ImageView>
   
   
<BorderPane style="-fx-background-color: transparent;">
   
   <!-- TOP BAR: Month, Phase, Event Name, and Options Buttons -->
   <top>
      <HBox alignment="CENTER" prefHeight="80.0" prefWidth="1280.0" style="-fx-background-color: rgba(37, 40, 44, 0.7); -fx-border-color: #3f444c; -fx-border-width: 0 0 2 0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <!-- Month & Phase Indicators -->
            <VBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="220.0" spacing="4.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label text="Mois :" textFill="#b9bec6">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="monthLabel" text="Avril (04)" textFill="#f59e0b">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label text="Phase :" textFill="#b9bec6">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="phaseLabel" text="Conseil" textFill="#10b981">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <!-- Event Title / Status Banner (Centered) -->
            <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" style="-fx-background-color: #2d3139; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-border-width: 1;">
                     <children>
                        <Label fx:id="eventLabel" text="Événement: Gargamel" textAlignment="CENTER" textFill="#f8fafc">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets bottom="8.0" left="24.0" right="24.0" top="8.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
            
            <!-- Actions/Settings Panel (Top Right) -->
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <ImageView fx:id="settingsButton" fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true" />
                  <ImageView fx:id="quitButton" fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>

   <!-- LEFT SIDEBAR: Pretty Resources Panel -->
   <left>
      <VBox alignment="TOP_CENTER" prefWidth="240.0" spacing="15.0" style="-fx-background-color: rgba(32, 34, 37, 0.7); -fx-border-color: #3f444c; -fx-border-width: 0 2 0 0;"  BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Ressources" textFill="#f1f5f9">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <VBox fx:id="resourcesContainer" prefHeight="517.0" prefWidth="208.0" spacing="12.0">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <padding>
                  <Insets bottom="4.0" top="4.0" />
               </padding>
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label text="Label" textFill="WHITE" />
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <StackPane alignment="CENTER_LEFT" prefHeight="60.0" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="4.0" top="4.0" />
                                 </padding>
                                 <children>
                                    <Rectangle arcHeight="5.0" arcWidth="5.0" fill="DODGERBLUE" height="24.0" stroke="BLACK" strokeType="INSIDE" width="100.0" />
                                    <Label text="Label" textFill="WHITE" StackPane.alignment="CENTER_RIGHT">
                                       <StackPane.margin>
                                          <Insets left="8.0" />
                                       </StackPane.margin>
                                    </Label>
                                 </children>
                              </StackPane>
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" />
                     </padding>
                  </VBox>
               </children></VBox>
         </children>
      </VBox>
   </left>

   <!-- CENTER PANEL: Subwindow Container -->
   <center>
      <StackPane fx:id="centerContainer" prefHeight="600.0" prefWidth="760.0" style="-fx-background-color: rgba(22, 24, 25, 0);" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <!-- Subwindows (like the Conseil table grid view) will be dynamically loaded inside this clean, empty placeholder -->
            <VBox alignment="CENTER" spacing="10.0" style="-fx-border-color: #3f444c; -fx-border-width: 2; -fx-border-style: dashed; -fx-background-color: #1d2022; -fx-background-radius: 10; -fx-border-radius: 10;">
               <children>
                  <Label text="[ Zone d'affichage des sous-fenêtres ]" textFill="#4b5563">
                     <font>
                        <Font name="System Italic" size="16.0" />
                     </font>
                  </Label>
                  <Label text="(Le contrôleur injectera dynamiquement vos menus ici)" textFill="#4b5563">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </StackPane>
   </center>

   <!-- RIGHT SIDEBAR: Pretty & Big Crisis Panel -->
   <right>
      <VBox alignment="TOP_CENTER" prefWidth="260.0" spacing="15.0" style="-fx-background-color: rgba(32, 34, 37, 0.7); -fx-border-color: #3f444c; -fx-border-width: 0 2 0 0;">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Crises" textFill="#f1f5f9">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <VBox fx:id="crisisContainer" alignment="TOP_CENTER" style="-fx-border-color: #3f444c; -fx-border-width: 1; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding></VBox>
            
            <!-- Crisis Pagination Controls -->
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="prevCrisisBtn" minWidth="45.0" mnemonicParsing="false" onAction="#handlePrevCrisis" style="-fx-background-color: #4b5563; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="&lt;">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <HBox alignment="CENTER" prefHeight="30.0" prefWidth="60.0" style="-fx-background-color: #2d3139; -fx-background-radius: 6; -fx-border-color: #4b5563; -fx-border-radius: 6;">
                     <children>
                        <Label fx:id="crisisPageLabel" text="1 / 3" textFill="#f1f5f9">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <Button fx:id="nextCrisisBtn" minWidth="45.0" mnemonicParsing="false" onAction="#handleNextCrisis" style="-fx-background-color: #4b5563; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="&gt;">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
            <VBox prefHeight="200.0" style="-fx-border-color: #3f444c; -fx-border-width: 1; -fx-border-radius: 10;">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <Label text="Total effets :" textFill="#f1f5f9">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <VBox fx:id="totalModifiersContainer" prefHeight="200.0" prefWidth="100.0" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </children>
      </VBox>
   </right>
</BorderPane>
</StackPane>
