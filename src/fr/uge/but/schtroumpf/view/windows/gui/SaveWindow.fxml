<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #1a1c1e;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.uge.but.schtroumpf.controller.gui.windows.SaveController">
   <top>
      <HBox alignment="CENTER" prefHeight="60.0" spacing="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
         <children>
            <Label text="SAUVEGARDER" textFill="#f8fafc">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            
            <!-- SECTION 1: CREATE A NEW SAVE -->
            <VBox maxWidth="500.0" prefHeight="130.0" prefWidth="450.0" spacing="10.0" style="-fx-background-color: #1a1c1e; -fx-background-radius: 8; -fx-border-color: #3f444c; -fx-border-radius: 8; -fx-border-width: 1;">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>
                  <Label text="Créer une nouvelle sauvegarde" textFill="#f8fafc">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <TextField fx:id="saveNameField" prefHeight="38.0" prefWidth="300.0" promptText="Nom de la sauvegarde (ex: partie1)..." style="-fx-background-color: #2d3139; -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-border-color: #3f444c; -fx-border-radius: 4; -fx-background-radius: 4;" HBox.hgrow="ALWAYS">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </TextField>
                        <Button mnemonicParsing="false" onAction="#handleCreateSave" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #4b5563; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" text="Sauvegarder" />
                     </children>
                  </HBox>
                  <Label fx:id="statusLabel" textFill="#10b981">
                     <font>
                        <Font name="System Italic" size="14.0" />
                     </font>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets bottom="40.0" />
               </VBox.margin>
            </VBox>
            
         </children>
      </VBox>
   </center>

   <bottom>
      <HBox alignment="CENTER" prefHeight="75.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: #4b5563; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Retour au jeu">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Button>
         </children>
         <padding>
            <Insets bottom="20.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
