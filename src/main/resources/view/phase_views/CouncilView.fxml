<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- ADDED: -fx-border-color: #3f444c; -fx-border-width: 2; to match Production/Event -->

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #1a1c1e; -fx-background-radius: 12; -fx-border-color: #3f444c; -fx-border-width: 2; -fx-border-radius: 12;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.uge.but.schtroumpf.controller.gui.phases.CouncilPhaseController">
   
   <top>
<HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="700.0" BorderPane.alignment="BOTTOM_RIGHT">
         <children>
            
            <Label text="CONSEIL DES SCHTROUMPFS" textFill="#f8fafc">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            
            <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />
            <Label text="Actions disponibles :" textFill="#94a3b8">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <Label fx:id="actionsCounterLabel" text="? / ?" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="2.0" left="8.0" right="8.0" top="2.0" />
               </padding>
            </Label>
            
         </children>
         <BorderPane.margin>
            <Insets bottom="4.0" />
         </BorderPane.margin>
         <padding>
            <Insets left="24.0" right="24.0" top="8.0" />
         </padding>
      </HBox>
   </top>

   <center>
      <HBox alignment="CENTER" prefHeight="310.0" prefWidth="660.0" spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
         </padding>
         <children>
            
            <VBox prefHeight="310.0" prefWidth="290.0" spacing="10.0" style="-fx-background-color: #202225; -fx-border-color: #3f444c; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <Label text="Selectionne un membres du Conseil" textFill="#cbd5e1">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <ScrollPane fx:id="councilScrollPane" fitToWidth="true" hbarPolicy="NEVER" prefHeight="220.0" style="-fx-background: #202225; -fx-background-color: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="smurfsListContainer" spacing="6.0" style="-fx-background-color: #202225;" />
                     </content>
                  </ScrollPane>
               </children>
            </VBox>
            
            <StackPane prefHeight="310.0" prefWidth="395.0" style="-fx-background-color: #202225; -fx-border-color: #3f444c; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
               <children>
               
                  <VBox fx:id="detailPanelContent" spacing="10.0" VBox.vgrow="ALWAYS">
                     <children>
                        <HBox fx:id="detailCardContainer" prefHeight="90.0" />
                        <ScrollPane fx:id="abilityScrollPane" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                           <content>
                              <VBox fx:id="detailAbilitiesContainer" style="-fx-background-color: transparent;">
                                 <padding>
                                    <Insets left="4.0" right="4.0" />
                                 </padding></VBox>
                           </content>
                        </ScrollPane>
                     </children>
                  </VBox>
                  
                  <VBox fx:id="emptyPlaceholderCard" alignment="CENTER" spacing="10.0" visible="false">
                     <children>
                        <Label text="Aucun Schtroumpf sélectionné" textFill="#cbd5e1">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <Label text="Choisissez un conseiller dans la liste à gauche." textFill="#64748b" />
                     </children>
                  </VBox>
                  
               </children>
            </StackPane>
            
         </children>
      </HBox>
   </center>

   <!-- UPDATED: Button is now 45px high, bold 16, Emerald Green, centered exactly like EventView -->
   <bottom>
      <VBox alignment="CENTER" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            
            <HBox alignment="CENTER" minHeight="30.0" prefHeight="30.0" style="-fx-background-color: #1a1c1e; -fx-background-radius: 6; -fx-border-color: #2d3139; -fx-border-width: 1; -fx-border-radius: 6;">
               <children>
                  <Label fx:id="statusFeedbackLabel" text="Sélectionnez un membre de conseil à gauche pour agir." textAlignment="CENTER" textFill="#94a3b8" wrapText="true">
                     <font>
                        <Font name="System Italic" size="14.0" />
                     </font>
                  </Label>
               </children>
               <padding>
                  <Insets left="15.0" right="15.0" />
               </padding>
            </HBox>
            
            <HBox alignment="CENTER">
               <children>
                  <Button fx:id="finishButton" mnemonicParsing="false" onAction="#handleFinish" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Terminer le Conseil">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="5.0" />
         </padding>
      </VBox>
   </bottom>
</BorderPane>
