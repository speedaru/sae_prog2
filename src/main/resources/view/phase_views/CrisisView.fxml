<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #1a1c1e; -fx-background-radius: 12; -fx-border-color: #3f444c; -fx-border-width: 2; -fx-border-radius: 12;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.uge.but.schtroumpf.controller.gui.phases.CrisisPhaseController">
   
   <top>
      <VBox alignment="CENTER" spacing="6.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="phaseTitleLabel" text="Crises" textAlignment="CENTER" textFill="#f8fafc">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label fx:id="phaseSubtitleLabel" text="Vérification des conditions de survie et des crises actives." textFill="#64748b" />
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </top>

   <center>
      <StackPane prefHeight="310.0" prefWidth="660.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="40.0" right="40.0" top="10.0" />
         </padding>
         <children>
            
            <VBox fx:id="safeStateContainer" alignment="CENTER" spacing="15.0" visible="false">
               <children>
                  <Label text="✅" textFill="#10b981">
                     <font>
                        <Font size="48.0" />
                     </font>
                  </Label>
                  <Label text="Le village est en sécurité" textFill="#f8fafc">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Label text="Aucune ressource vitale n'est épuisée. Les Schtroumpfs sont prêts pour le mois suivant !" textAlignment="CENTER" textFill="#cbd5e1" wrapText="true" />
               </children>
            </VBox>

            <VBox fx:id="crisisListWrapper" spacing="10.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="CRISES EN COURS :" textFill="#ef4444">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="crisisCountBadge" style="-fx-background-color: #ef4444; -fx-padding: 2 6 2 6; -fx-background-radius: 10;" text="1 / 3" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="crisisCardsContainer" spacing="10.0" style="-fx-background-color: transparent;" />
                     </content>
                  </ScrollPane>
               </children>
            </VBox>

            <VBox fx:id="gameOverContainer" alignment="CENTER" spacing="15.0" style="-fx-background-color: #7f1d1d; -fx-background-radius: 8;" visible="false">
               <children>
                  <Label text="💀 DÉFAITE" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="36.0" />
                     </font>
                  </Label>
                  <Label text="Le village s'est effondré sous le poids de 3 crises simultanées." textFill="#fca5a5">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
               </padding>
            </VBox>

         </children>
      </StackPane>
   </center>

   <!-- UPDATED: Button is now 45px high, bold 16, Emerald Green, centered exactly like EventView -->
   <bottom>
      <VBox alignment="CENTER" prefHeight="75.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="nextMonthButton" mnemonicParsing="false" onAction="#handleNextMonth" prefHeight="45.0" prefWidth="280.0" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Commencer le mois suivant">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Button>
            
            <HBox fx:id="gameOverButtonsBox" alignment="CENTER" managed="false" spacing="15.0" visible="false">
               <children>
                  <!-- Styled Quitter button for Game Over, slightly adjusted to match the 45px height -->
                  <Button mnemonicParsing="false" onAction="#handleQuit" prefHeight="45.0" prefWidth="140.0" style="-fx-background-color: transparent; -fx-border-color: #ef4444; -fx-text-fill: #ef4444; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-width: 2; -fx-cursor: hand;" text="Quitter">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="20.0" />
         </padding>
      </VBox>
   </bottom>
</BorderPane>
