            <Button mnemonicParsing="false" onAction="#handleMainMenu" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Retour au Menu Principal">
