<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #1a1c1e;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.uge.but.schtroumpf.controller.gui.windows.LoadSaveController">
   <top>
      <HBox alignment="CENTER" prefHeight="60.0" spacing="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
         <children>
            <Label text="CHARGER UNE SAUVEGARDE" textFill="#f8fafc">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>
   <center>
      <VBox spacing="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            
            <!-- SECTION: SELECT AND LOAD -->
            <VBox spacing="10.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="Sélectionnez une sauvegarde dans la liste" textFill="#cbd5e1">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <ScrollPane fitToWidth="true" prefHeight="504.0" prefWidth="1240.0" style="-fx-border-color: #3f444c; -fx-background: #1a1c1e; -fx-background-color: #1a1c1e; -fx-border-radius: 6; -fx-background-radius: 6;" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="savesContainer" spacing="10.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>
            
         </children>
      </VBox>
   </center>
   <bottom>
      
            <!-- STATUS FEEDBACK AND TRIGGER ACTION BAR -->
      <HBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#handleBack" prefHeight="45.0" prefWidth="100.0" style="-fx-background-color: #3f444c; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand;" text="Retour" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Button>
            <Button fx:id="loadButton" disable="true" mnemonicParsing="false" onAction="#handleLoadSelected" prefHeight="45.0" prefWidth="230.0" style="-fx-background-color: #10b981; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand;" text="Charger la sauvegarde">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Button>
         </children>
         <padding>
            <Insets bottom="20.0" left="10.0" right="10.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
